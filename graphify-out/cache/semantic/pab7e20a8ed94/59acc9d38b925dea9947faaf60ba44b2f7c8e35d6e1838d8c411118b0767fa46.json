{"nodes": [{"id": "theory_05_cbet_oop_40bb_01_guideline_doc", "label": "Guideline \u2014 C-Bet OOP", "file_type": "document", "source_file": "theory/05-CBet-OOP-40bb/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_05_cbet_oop_40bb_01_guideline_cbet_oop", "label": "C-Bet OOP (SRP 40bb Flop)", "file_type": "concept", "source_file": "theory/05-CBet-OOP-40bb/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "N\u00e3o \u00e9 baseado apenas em frequ\u00eancia; constr\u00f3i range de bet e de check para evitar check fraco."}, {"id": "theory_05_cbet_oop_40bb_01_guideline_split_range", "label": "Split Range", "file_type": "concept", "source_file": "theory/05-CBet-OOP-40bb/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Divide grande parte do range entre bet e check: metade dos TP e Second Pairs com naipes do board, 2 pontas sem naipe, brocas com naipe, BDFD/BDST."}, {"id": "theory_05_cbet_oop_40bb_01_guideline_split_25", "label": "Split 25%", "file_type": "concept", "source_file": "theory/05-CBet-OOP-40bb/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "S\u00f3 parte menor aposta: 25% dos TP (off com naipe do FD, suited com BDFD), 2 pontas e brocas com naipe do board; primeiro naipe para XR."}, {"id": "theory_05_cbet_oop_40bb_01_guideline_protecao_range_de_check", "label": "Prote\u00e7\u00e3o do Range de Check", "file_type": "concept", "source_file": "theory/05-CBet-OOP-40bb/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parte das m\u00e3os fortes (incl. trincas) fica no check para que o advers\u00e1rio n\u00e3o ataque todo o check."}, {"id": "theory_05_cbet_oop_40bb_01_guideline_estrategia_por_textura", "label": "Estrat\u00e9gia por Textura do Flop (C-Bet OOP)", "file_type": "concept", "source_file": "theory/05-CBet-OOP-40bb/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A High seco, A High conectado, BBX, K-Q High, J-T High, High/Low com seguida, Low sem seguida, Monotone; sizes B25/B40/B70."}, {"id": "theory_05_cbet_oop_40bb_01_guideline_ep_vs_btn", "label": "EP vs BTN", "file_type": "concept", "source_file": "theory/05-CBet-OOP-40bb/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_05_cbet_oop_40bb_01_guideline_co_vs_btn", "label": "CO vs BTN", "file_type": "concept", "source_file": "theory/05-CBet-OOP-40bb/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_05_cbet_oop_40bb_01_guideline_monotone_co_vs_btn_check_range", "label": "Monotone CO vs BTN \u2014 Check Range", "file_type": "concept", "source_file": "theory/05-CBet-OOP-40bb/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_05_cbet_oop_40bb_01_guideline_second_barrel_oop", "label": "Second Barrel OOP (Turn)", "file_type": "concept", "source_file": "theory/05-CBet-OOP-40bb/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fonte: guideline do instrutor, ainda sem aula; cobre apenas range de valor (Blank B100, Din\u00e2mico seco B40/B70, carregado B100, flush B40)."}, {"id": "theory_05_cbet_oop_40bb_01_guideline_size_por_largura_do_range", "label": "Size Acompanha a Largura do Range de Valor", "file_type": "rationale", "source_file": "theory/05-CBet-OOP-40bb/01-Guideline.md", "source_location": null, "source_url": null, "capture