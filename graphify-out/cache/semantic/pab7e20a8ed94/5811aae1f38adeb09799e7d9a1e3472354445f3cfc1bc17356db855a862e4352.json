{"nodes": [{"id": "theory_14_probe_turn_01_guideline_doc", "label": "Guideline \u2014 Probe Turn", "file_type": "document", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_range_check_atras_btn", "label": "Range de check atr\u00e1s do BTN", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O BTN j\u00e1 apostou o mais forte no flop; sobra mid value: Ax, KQ/KJ, middle/third pair, brocas, BDFD, give-ups."}, {"id": "theory_14_probe_turn_01_guideline_board_base_875", "label": "Board base 875 com flush draw (8\u2660 7\u2666 5\u2660)", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_size_nasce_do_grupo", "label": "Regra 5 \u2014 O size nasce do grupo de m\u00e3os que voc\u00ea quer apostar", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resumo da aula: entendendo o grupo de m\u00e3os, o size sai sozinho."}, {"id": "theory_14_probe_turn_01_guideline_b70", "label": "B70 (TP e SP; board conectado)", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_b100", "label": "B100 / geom\u00e9trico (trinca e TP muito forte; board seco)", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_b40", "label": "B40 (vil\u00e3o d\u00e1 raise ou thin value)", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Size baixo s\u00f3 extrai de range largo de m\u00e3os piores ou quando o vil\u00e3o coloca fichas."}, {"id": "theory_14_probe_turn_01_guideline_b25_range_inteiro", "label": "Regra 9 \u2014 N\u00e3o aposte B25 com o range inteiro", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "N\u00e3o faz foldar, n\u00e3o extrai, e cria \u00e1rvore de river que ningu\u00e9m sabe jogar."}, {"id": "theory_14_probe_turn_01_guideline_conectado_b70_seco_b100", "label": "Regra 6 \u2014 Board conectado pede B70, board seco pede B100", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conectado: muita equity direta no range de bet; size alto daria equity ao range de call e tiraria os 7x do bet. Seco (873): 8x \u00e9 o absoluto."}, {"id": "theory_14_probe_turn_01_guideline_size_unico_por_situacao", "label": "Regra 8 \u2014 Um size \u00fanico por situa\u00e7\u00e3o", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V\u00e1rios sizes exigem sorteios impratic\u00e1veis; o instrutor usa o size m\u00e9dio do GTO Wizard."}, {"id": "theory_14_probe_turn_01_guideline_board_atipico", "label": "Regra 4 \u2014 Board at\u00edpico: assuma o range de check atr\u00e1s", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_btn_forte_maos_topo", "label": "Regra 2 \u2014 BTN mais forte acrescenta m\u00e3os de topo (AA, KK, 88, 77)", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_bluff_equity_direta", "label": "Regra 10 \u2014 Bluff \u00e9 sempre equity direta", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fora de posi\u00e7\u00e3o n\u00e3o se pode colocar fichas com m\u00e3os de zero equity contra o range de call."}, {"id": "theory_14_probe_turn_01_guideline_broca_equity_extra", "label": "Regra 11 \u2014 A broca precisa de equity extra quando o board \u00e9 ruim", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_check_call_tp_sp_par_draw", "label": "Regra 12 \u2014 No check-call, nunca folde TP, SP nem par com draw", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_size_vilao_equity", "label": "Regra 13 \u2014 Quanto maior o size do vil\u00e3o, mais equity para pagar", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_board_muda_nuts", "label": "Regra 14 \u2014 Num board que muda o nuts, o call exige mais equity", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_xr_valor_combo_draw", "label": "Regra 15 \u2014 XR: valor muito forte e combo draw", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "XR por bluff precisa de muita equity porque, pago, ainda precisa buscar o jogo."}, {"id": "theory_14_probe_turn_01_guideline_piores_maos_para_check", "label": "Regra 16 \u2014 As piores m\u00e3os de cada grupo v\u00e3o para o check", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desbloqueiam as cartas que pagam (9 e 10)."}, {"id": "theory_14_probe_turn_01_guideline_sequencias_naipe_board", "label": "Regra 17 \u2014 Sequ\u00eancias e o naipe do board [Confirmar]", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_adaptacao_frequencia", "label": "Regra 18 \u2014 A constru\u00e7\u00e3o n\u00e3o muda, quem muda \u00e9 a frequ\u00eancia", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_14_probe_turn_01_guideline_divisao_flushes", "label": "Divis\u00e3o dos flushes (alta+baixa bet, duas altas XR, duas baixas XC)", "file_type": "concept", "source_file": "theory/14-Probe-Turn/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_1