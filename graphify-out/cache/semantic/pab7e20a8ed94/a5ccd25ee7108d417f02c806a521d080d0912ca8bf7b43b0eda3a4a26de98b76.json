{"nodes": [{"id": "theory_07_xr_deep_01_guideline_xr_deep_stack", "label": "XR Deep Stack", "file_type": "concept", "source_file": "theory/07-XR-DEEP/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "XR no Deep Stack \u00e9 constru\u00eddo com mais equidade: ranges que continuam contra a\u00e7\u00e3o, realizam equidade, extraem com m\u00e3os fortes e pressionam com m\u00e3os com potencial de evolu\u00e7\u00e3o."}, {"id": "theory_07_xr_deep_01_guideline_sem_slowplay_deep", "label": "Sem Slowplay no Deep Stack", "file_type": "rationale", "source_file": "theory/07-XR-DEEP/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M\u00e3os muito fortes usam XR para construir pote, diminuir SPR e pressionar o range advers\u00e1rio em vez de slowplay."}, {"id": "theory_07_xr_deep_01_guideline_xr_valor_por_posicao", "label": "XR por Valor (EP 1-2 / BU 3-4 melhores Top Pairs)", "file_type": "concept", "source_file": "theory/07-XR-DEEP/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contra EP usar 1-2 melhores TP ou melhor; contra BU 3-4 melhores TP ou melhor; quanto mais carregado o board, menos TP no XR."}, {"id": "theory_07_xr_deep_01_guideline_top_pair_no_xr", "label": "Top Pair no XR Deep", "file_type": "concept", "source_file": "theory/07-XR-DEEP/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top Pair n\u00e3o entra automaticamente no XR: considerar kicker, textura, capacidade de continuar e prote\u00e7\u00e3o; guardar m\u00e3os para XC e calldown."}, {"id": "theory_07_xr_deep_01_guideline_xr_bluff", "label": "XR Bluff com Equidade", "file_type": "concept", "source_file": "theory/07-XR-DEEP/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bluffs constru\u00eddos com 2 pontas, brocas com estrutura, FD, FD com cartas altas e combo draws."}, {"id": "theory_07_xr_deep_01_guideline_turns_apos_xr", "label": "Turns ap\u00f3s XR Flop (Blank B70+ / Din\u00e2mico B40)", "file_type": "concept", "source_file": "theory/07-XR-DEEP/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_07_xr_deep_01_guideline_spr_construcao_pote", "label": "SPR e Constru\u00e7\u00e3o de Pote", "file_type": "concept", "source_file": "theory/07-XR-DEEP/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SPR menor n\u00e3o significa automaticamente shove; depende da necessidade de prote\u00e7\u00e3o e da fun\u00e7\u00e3o da m\u00e3o."}, {"id": "theory_07_xr_deep_01_guideline_conceito_central_ev", "label": "Equidade suficiente e linha de maior EV", "file_type": "rationale", "source_file": "theory/07-XR-DEEP/01-Guideline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pergunta n\u00e3o \u00e9 'minha m\u00e3o \u00e9 forte?' e sim 'minha m\u00e3o possui equidade suficiente e qual linha extrai mais EV?'."}], "edges": [{"source": "theory_07_xr_deep_01_guideline_sem_slowplay_deep", "target": "theory_07_xr_deep_01_guideline_xr_deep_stack", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "theory/07-XR-DEEP/01-Guideline.md", "source_location": null, "weight": 1.0}, {"source": "theory_07_xr_deep_01_guideline_xr_valor_por_posicao", "target": "theory_07_xr_deep_01_guideline_xr_deep_stack", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "theory/07-XR-DEEP/01-Guideline.md", "source_location": null, "weight": 1.0}