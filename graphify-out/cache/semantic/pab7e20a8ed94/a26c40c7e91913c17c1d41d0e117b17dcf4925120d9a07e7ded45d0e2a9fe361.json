{"nodes": [{"id": "theory_04_third_barrel_e_vs_third_barrel_09_decisoes_doc", "label": "Decis\u00f5es \u2013 Third Barrel", "file_type": "document", "source_file": "theory/04-Third-Barrel-e-vs-Third-Barrel/09-Decisoes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_04_third_barrel_e_vs_third_barrel_09_decisoes_modulo_unico", "label": "Third Barrel e Vs Third Barrel em M\u00f3dulo \u00danico", "file_type": "rationale", "source_file": "theory/04-Third-Barrel-e-vs-Third-Barrel/09-Decisoes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Os temas s\u00e3o complementares: o range ofensivo depende das m\u00e3os que o advers\u00e1rio defende e vice-versa."}, {"id": "theory_04_third_barrel_e_vs_third_barrel_09_decisoes_river_nao_isolado", "label": "River N\u00e3o Deve Ser Analisado Isoladamente", "file_type": "rationale", "source_file": "theory/04-Third-Barrel-e-vs-Third-Barrel/09-Decisoes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toda decis\u00e3o no River considera constru\u00e7\u00e3o do Flop, do Turn e composi\u00e7\u00e3o dos ranges."}, {"id": "theory_04_third_barrel_e_vs_third_barrel_09_decisoes_range_polar_vs_linear", "label": "Separa\u00e7\u00e3o entre Range Polar e Range Linear", "file_type": "concept", "source_file": "theory/04-Third-Barrel-e-vs-Third-Barrel/09-Decisoes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Range Polar continua quando completa draws; Range Linear continua quando o River \u00e9 Blank."}, {"id": "theory_04_third_barrel_e_vs_third_barrel_09_decisoes_blockers_consideram_folds", "label": "Blockers Devem Considerar Folds", "file_type": "concept", "source_file": "theory/04-Third-Barrel-e-vs-Third-Barrel/09-Decisoes.md", "source_location": null, "s