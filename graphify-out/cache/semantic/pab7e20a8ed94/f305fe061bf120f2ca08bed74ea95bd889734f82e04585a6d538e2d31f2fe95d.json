{"nodes": [{"id": "theory_09_bet_check_bet_04_exercicios_exercicios_bcb", "label": "Exerc\u00edcios Bet Check Bet", "file_type": "document", "source_file": "theory/09-BET-CHECK-BET/04-Exercicios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theory_09_bet_check_bet_04_exercicios_exercicio_01", "label": "Exerc\u00edcio 01 \u2014 A\u26639\u2660 em T-7-3-3-Q (High Card, CHECK)", "file_type": "document", "source_file": "theory/09-BET-CHECK-BET/04-Exercicios.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A m\u00e3o bloqueia Ax, exatamente o range que queremos fazer foldar."}, {"id": "theory_09_bet_check_bet_04_exercicios_exercicio_02", "label": "Exerc\u00edcio 02 \u2014 K\u26603\u2660 com \u00c1s no river (Din\u00e2mico Ax, CHECK)", "file_type": "document", "source_file": "theory/09-BET-CHECK-BET/04-Exercicios.md", "source_location": "L113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Com \u00c1s no river Ax vira valor; alvo passa a ser Kx e pares m\u00e9dios, e o K bloqueia esse alvo."}, {"id": "theory_09_bet_check_bet_04_exercicios_exercicio_03", "label": "Exerc\u00edcio 03 \u2014 J\u2663T\u2663 em 9\u26665\u2666T\u2663K\u26604\u2666 (Din\u00e2mico Flush, BET B70)", "file_type": "document", "source_file": "theory/09-BET-CHECK-BET/04-Exercicios.md", "source_location": "L191", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Est\u00e1 entre os melhores second pairs que chegam ao river."}, {"id": "theory_09_bet_check_bet_04_exercicios_exercicio_04", "label": "Exerc\u00edcio 04 \u2014 K\u26669\u2666 em Q-2-5-6-T (Blank, BET B70 BLUFF)", "file_type": "document", "source_file": "theory/09-BET-CHECK-BET/04-Exercicios.md", "source_location": "L283", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "N\u0